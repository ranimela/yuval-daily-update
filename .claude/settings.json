{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)"
    ],
    "ask": [
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git merge*)"
    ]
  }
}
